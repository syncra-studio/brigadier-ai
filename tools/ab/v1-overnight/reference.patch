diff --git a/test/invoice.test.ts b/test/invoice.test.ts
index a060a8d..9da50b3 100644
--- a/test/invoice.test.ts
+++ b/test/invoice.test.ts
@@ -83,3 +83,18 @@ describe('renderInvoiceText', () => {
     assert.equal(line, 'TEA-200   An Extremely Long Pr...     1      8.75      8.75');
   });
 });
+
+describe('invoice notes', () => {
+  test('a note is kept and printed as the last line', () => {
+    const invoice = buildInvoice(sampleCart(), sampleCatalog(), { ...OPTS, note: 'Paid by card' });
+    assert.equal(invoice.note, 'Paid by card');
+    const lines = renderInvoiceText(invoice).trimEnd().split('\n');
+    assert.equal(lines.at(-1), 'Note: Paid by card');
+  });
+
+  test('without a note nothing changes', () => {
+    const invoice = buildInvoice(sampleCart(), sampleCatalog(), OPTS);
+    assert.equal('note' in invoice, false);
+    assert.doesNotMatch(renderInvoiceText(invoice), /Note:/);
+  });
+});
