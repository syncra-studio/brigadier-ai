{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brigadier queue --json",
  "type": "object",
  "required": [
    "id",
    "state",
    "already"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "state": {
      "enum": [
        "joined",
        "waiting",
        "sent-to-worker",
        "offered"
      ]
    },
    "already": {
      "type": "boolean",
      "description": "Always false: nothing joins a message by itself; kept so the output's names stay stable."
    },
    "worker": {
      "type": "string",
      "description": "For sent-to-worker: the worker's id."
    }
  }
}
