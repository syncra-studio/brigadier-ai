{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brigadier models --json",
  "type": "object",
  "required": [
    "workersAtOnce",
    "models",
    "agents",
    "switchProviders",
    "accounts",
    "guidance",
    "rules"
  ],
  "additionalProperties": false,
  "properties": {
    "workersAtOnce": {
      "description": "How many workers this session may run at the same time: the user's setting (Settings > Configuration > Workers). Advice; start refuses no further worker.",
      "type": "integer",
      "minimum": 1
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "model",
          "available",
          "efforts",
          "ageS"
        ],
        "additionalProperties": false,
        "properties": {
          "agent": {
            "enum": [
              "claude",
              "codex"
            ]
          },
          "model": {
            "type": "string"
          },
          "available": {
            "type": "boolean"
          },
          "efforts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ageS": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "agent",
          "switchAccounts"
        ],
        "additionalProperties": false,
        "properties": {
          "agent": {
            "enum": [
              "claude",
              "codex"
            ]
          },
          "switchAccounts": {
            "type": "boolean"
          }
        }
      }
    },
    "switchProviders": {
      "type": "boolean"
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "agent",
          "current",
          "usage",
          "name",
          "you",
          "loggedIn",
          "ageS",
          "fit",
          "place",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "agent": {
            "enum": [
              "claude",
              "codex"
            ]
          },
          "current": {
            "type": "boolean"
          },
          "usage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "window",
                "usedPercent",
                "resetsAtMs",
                "model",
                "bucket",
                "pooled",
                "runwayMs",
                "estimateRough"
              ],
              "additionalProperties": false,
              "properties": {
                "window": {
                  "type": "string"
                },
                "usedPercent": {
                  "type": "number"
                },
                "resetsAtMs": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "model": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "bucket": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "pooled": {
                  "type": "boolean"
                },
                "runwayMs": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "estimateRough": {
                  "type": "boolean"
                }
              }
            }
          },
          "name": {
            "type": "string"
          },
          "you": {
            "type": "boolean"
          },
          "loggedIn": {
            "type": "boolean"
          },
          "ageS": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fit": {
            "type": "string"
          },
          "place": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "why": {
            "type": "string"
          }
        }
      }
    },
    "guidance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "work",
          "agent",
          "model",
          "effort",
          "reason",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "work": {
            "type": "string"
          },
          "agent": {
            "enum": [
              "claude",
              "codex"
            ]
          },
          "model": {
            "type": "string"
          },
          "effort": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          },
          "source": {
            "enum": [
              "shipped",
              "user"
            ]
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string"
          }
        }
      }
    }
  }
}
