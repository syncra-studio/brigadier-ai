{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brigadier wait --json",
  "type": "object",
  "required": [
    "events",
    "timedOut"
  ],
  "additionalProperties": false,
  "properties": {
    "timedOut": {
      "type": "boolean"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "event",
          "atMs"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "eventId": {
            "type": "string",
            "description": "The event's own id: the same each time it is shown, and heard once."
          },
          "event": {
            "enum": [
              "turn-ended",
              "needs-input",
              "failed",
              "interrupted",
              "gone",
              "usage-limit",
              "fresh-context",
              "quiet"
            ]
          },
          "message": {
            "type": "string",
            "description": "A turn's last message; why it failed, stopped or is gone; a usage limit; what runs while it is quiet."
          },
          "asks": {
            "type": "string",
            "description": "What a permission prompt, a question or a sign-in asks."
          },
          "resetsAtMs": {
            "type": "integer"
          },
          "atMs": {
            "type": "integer"
          }
        }
      }
    }
  }
}
