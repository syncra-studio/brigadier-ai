{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brigadier preview --json (planned)",
  "type": "object",
  "required": [
    "action",
    "name"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "start",
        "stop",
        "log"
      ]
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "starting",
        "running",
        "stopped",
        "failed"
      ]
    },
    "log": {
      "type": "string"
    }
  }
}
