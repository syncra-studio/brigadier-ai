{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brigadier start --json",
  "type": "object",
  "required": [
    "worker",
    "permission",
    "base"
  ],
  "additionalProperties": false,
  "properties": {
    "worker": {
      "$ref": "#/$defs/worker"
    },
    "permission": {
      "enum": [
        "ask",
        "accept-edits",
        "full-access"
      ],
      "description": "The permission mode it runs in."
    },
    "base": {
      "type": [
        "string",
        "null"
      ],
      "description": "The branch its worktree started from and merges back into; null with --local."
    },
    "row": {
      "type": "object",
      "description": "With --work: the rules-file row that picked what the flags left out.",
      "required": [
        "work",
        "source",
        "picked"
      ],
      "additionalProperties": false,
      "properties": {
        "work": {
          "type": "string"
        },
        "source": {
          "enum": [
            "user",
            "shipped"
          ]
        },
        "picked": {
          "type": "array",
          "items": {
            "enum": [
              "agent",
              "model",
              "effort"
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "changes": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "files",
        "insertions",
        "deletions"
      ],
      "additionalProperties": false,
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "insertions": {
          "type": "integer",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "worker": {
      "type": "object",
      "required": [
        "id",
        "number",
        "title",
        "agent",
        "model",
        "effort",
        "state",
        "branch",
        "changes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": "string"
        },
        "agent": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "effort": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "queued",
            "starting",
            "working",
            "asking",
            "paused",
            "reported",
            "taken-over",
            "landing",
            "ready-to-land",
            "landed",
            "done",
            "rejected",
            "stopped",
            "failed"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "changes": {
          "$ref": "#/$defs/changes"
        },
        "context": {
          "description": "How full its context is, as its CLI last said; null before it said and once it ended.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "usedTokens",
            "windowTokens"
          ],
          "additionalProperties": false,
          "properties": {
            "usedTokens": {
              "type": "integer",
              "minimum": 0
            },
            "windowTokens": {
              "type": [
                "integer",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
