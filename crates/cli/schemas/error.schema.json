{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brigadier --json output of a failed call",
  "type": "object",
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "usage",
            "refused",
            "not-available",
            "unreachable",
            "not-found",
            "ambiguous",
            "version",
            "failed"
          ]
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
