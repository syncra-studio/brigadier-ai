{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brigadier browser --json (planned)",
  "type": "object",
  "required": [
    "action",
    "tab"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "open",
        "navigate",
        "read",
        "click",
        "type",
        "screenshot",
        "close",
        "show"
      ]
    },
    "tab": {
      "type": "string"
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": "string"
    },
    "image": {
      "type": "string",
      "description": "A screenshot, as a data: URL."
    }
  }
}
