{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brigadier browser --json",
  "type": "object",
  "required": [
    "action",
    "text"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "open",
        "navigate",
        "read",
        "click",
        "type",
        "screenshot",
        "close",
        "show"
      ]
    },
    "text": {
      "type": "string",
      "description": "What the tool answered."
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Screenshots, as data: URLs."
    }
  }
}
