{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "brigadier page --json (planned)",
  "type": "object",
  "required": [
    "action"
  ],
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "list",
        "read",
        "write"
      ]
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "updatedAtMs"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "updatedAtMs": {
            "type": "integer"
          }
        }
      }
    },
    "name": {
      "type": "string"
    },
    "text": {
      "type": "string"
    }
  }
}
