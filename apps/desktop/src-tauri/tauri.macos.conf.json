{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Brigadier",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "theme": "Dark",
        "transparent": true,
        "windowEffects": { "effects": ["menu"], "state": "active" },
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 24 }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "signingIdentity": "-"
    }
  }
}
