{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brigadier",
  "version": "0.1.0",
  "identifier": "ai.brigadier.app",
  "build": {
    "beforeDevCommand": "pnpm stage-sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm stage-sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Brigadier",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0f0f0e",
        "theme": "Dark",
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Local-first orchestrator for long-running AI coding sessions",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/brigadierd", "binaries/brigadier"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true
    }
  }
}
