  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings",
    "test": "node --import ./scripts/test-alias.mjs --test \"src/**/*.test.ts\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:debug-app": "tauri build --debug --bundles app --config src-tauri/tauri.dev.conf.json",
    "stage-sidecar": "node scripts/stage-sidecar.mjs"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.21",
