+/// The app behind one exact window. Frame hosts are shared, so attribution
+/// must come from that frame's CoreWindow child, never a process-wide guess.
+pub fn window_app_pid(hwnd: u64) -> Option<u32> {
+    let owner = window_owner_pid(hwnd)?;
+    Some(resolve_uwp_app_pid(owner, hwnd).unwrap_or(owner))
