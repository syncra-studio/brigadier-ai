+#[cfg(test)]
+mod hosted_identity_tests {
+    use super::*;
+
+    fn frame(hwnd: u64) -> WindowInfo {
+        WindowInfo {
+            hwnd,
+            pid: 100,
+            title: "Hosted app".into(),
+            x: 0,
+            y: 0,
+            width: 100,
+            height: 100,
+            is_on_screen: true,
+            minimized: false,
+        }
+    }
+
+    #[test]
+    fn shared_frame_host_is_attributed_and_filtered_per_window() {
+        let frames = vec![frame(10), frame(20)];
+        let app = |hwnd| match hwnd {
+            10 => Some(1508),
+            20 => Some(29628),
+            _ => None,
+        };
+        let owner = |_| Some(100);
+        let all = attribute_windows(frames.clone(), None, app, owner);
+        assert_eq!(all.iter().map(|w| w.pid).collect::<Vec<_>>(), [1508, 29628]);
+        let settings = attribute_windows(frames.clone(), Some(1508), app, owner);
+        assert_eq!(settings.len(), 1);
+        assert_eq!(settings[0].hwnd, 10);
+        assert_eq!(settings[0].pid, 1508);
+        let calculator = attribute_windows(frames.clone(), Some(29628), app, owner);
+        assert_eq!(calculator[0].hwnd, 20);
+        // Old callers naming the native frame host can still discover both.
+        assert_eq!(
+            attribute_windows(frames.clone(), Some(100), app, owner).len(),
+            2
+        );
+        assert!(attribute_windows(frames, Some(999), app, owner).is_empty());
+    }
+
+    #[test]
+    fn missing_hosted_child_preserves_native_identity() {
+        let windows = attribute_windows(vec![frame(10)], Some(100), |_| None, |_| Some(100));
+        assert_eq!(windows[0].pid, 100);
+    }
+}
