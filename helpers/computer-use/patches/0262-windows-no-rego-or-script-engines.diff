Why: The windows backend asks for cua-driver-core without its Rego and QuickJS engines, keeping YAML policies, as patch 0261 does for macOS, so an embedding app that never uses them can leave them out of its binary.

diff --git a/crates/platform-windows/Cargo.toml b/crates/platform-windows/Cargo.toml
index eb8771d13..7148bfda8 100644
--- a/crates/platform-windows/Cargo.toml
+++ b/crates/platform-windows/Cargo.toml
@@ -12,7 +12,7 @@ anyhow = { workspace = true }
 thiserror = { workspace = true }
 tracing = { workspace = true }
 async-trait = "0.1"
-cua-driver-core = { path = "../cua-driver-core" }
+cua-driver-core = { path = "../cua-driver-core", default-features = false, features = ["yaml"] }
 cua-driver-contract = { path = "../cua-driver-contract" }
 cursor-overlay = { path = "../cursor-overlay" }
 pip-preview = { path = "../pip-preview" }
