Why: The linux backend asks for cua-driver-core without its Rego and QuickJS engines, keeping YAML policies, as patch 0262 does for macOS, so an embedding app that never uses them can leave them out of its binary.

diff --git a/crates/platform-linux/Cargo.toml b/crates/platform-linux/Cargo.toml
index dfb5ec0fd..2aa6d8f63 100644
--- a/crates/platform-linux/Cargo.toml
+++ b/crates/platform-linux/Cargo.toml
@@ -13,7 +13,7 @@ thiserror = { workspace = true }
 tracing = { workspace = true }
 async-trait = "0.1"
 futures-util = "0.3"
-cua-driver-core = { path = "../cua-driver-core" }
+cua-driver-core = { path = "../cua-driver-core", default-features = false, features = ["yaml"] }
 cua-driver-contract = { path = "../cua-driver-contract" }
 cursor-overlay = { path = "../cursor-overlay" }
 pip-preview = { path = "../pip-preview" }
