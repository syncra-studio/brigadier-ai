@@ -151,6 +151,9 @@ fn restore_target(
     order_before: &[u32],
     on_screen_now: &[u32],
 ) -> Option<u32> {
+    if previous == Some(target) {
+        return None;
+    }
     let present = |w: &u32| *w != target && on_screen_now.contains(w);
     previous
         .filter(present)
@@ -1789,6 +1792,12 @@ mod key_prime_tests {
         assert_eq!(r, Ok(KeyPrime::KeyRecords));
     }

+    #[test]
+    fn regression_priming_preserves_an_already_focused_target() {
+        assert_eq!(restore_target(7, Some(7), &[7, 9], &[7, 9]), None);
+        assert_eq!(restore_target(7, Some(7), &[9, 7], &[9, 7]), None);
+    }
+
     #[test]
