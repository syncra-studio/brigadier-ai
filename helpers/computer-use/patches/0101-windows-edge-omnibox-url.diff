+pub(crate) fn is_omnibox(automation_id: &str, class_name: &str) -> bool {
+    matches!(automation_id.to_ascii_lowercase().as_str(), "addresseditbox" | "omnibox" | "urlbar")
+        || class_name.eq_ignore_ascii_case("OmniboxView")
