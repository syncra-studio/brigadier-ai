+    match error {
+        UiaDeadlineError::Timeout => {
+            "the app's accessibility provider did not respond within 4 seconds"
+        }
+        UiaDeadlineError::Busy => "an earlier accessibility provider call is still running",
+        UiaDeadlineError::Unavailable => {
