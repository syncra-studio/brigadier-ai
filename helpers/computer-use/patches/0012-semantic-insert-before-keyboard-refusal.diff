+    retained_element: bool,
+    is_terminal: bool,
+    key_scope: impl FnOnce() -> Result<Option<S>, String>,
+    dispatch: impl FnOnce(KeyboardRoute) -> anyhow::Result<TypeTextDelivery>,
+) -> anyhow::Result<TypeTextDelivery> {
