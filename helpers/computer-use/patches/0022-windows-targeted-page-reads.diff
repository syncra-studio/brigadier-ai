+/// Windows read dispatcher: URL hints must reach the document selector, never
+/// the cross-platform legacy read path which has no target parameters.
+pub(super) struct WindowsPageTool {
+    legacy: cua_driver_core::page::PageTool,
+}
+
+impl WindowsPageTool {
+    pub(super) fn new() -> Self {
+        Self {
+            legacy: cua_driver_core::page::PageTool::new(std::sync::Arc::new(
+                WindowsPageBackend::new(),
+            )),
+        }
+    }
+}
+
+#[async_trait]
+impl cua_driver_core::tool::Tool for WindowsPageTool {
+    fn def(&self) -> &cua_driver_core::tool::ToolDef {
+        self.legacy.def()
+    }
+
+    async fn invoke(&self, args: serde_json::Value) -> cua_driver_core::protocol::ToolResult {
+        use super::browser_target::{page_read_route, PageReadRoute};
+        use cua_driver_core::protocol::ToolResult;
+        let action = args
+            .get("action")
+            .and_then(serde_json::Value::as_str)
+            .unwrap_or("");
+        if !matches!(action, "get_text" | "query_dom") {
+            return self.legacy.invoke(args).await;
+        }
+        match page_read_route(args.get("target_url_contains").is_some(), args.get("cdp_port").is_some()) {
+            PageReadRoute::Legacy => return self.legacy.invoke(args).await,
+            PageReadRoute::RefuseUnboundPort => return ToolResult::error(
+                "Windows page reads cannot bind the supplied CDP port to this window. No page was read. Omit cdp_port to read the URL-matched document through UI Automation."
+            ),
+            PageReadRoute::MatchedDocument => {}
+        }
+        let Some(hint) = args
+            .get("target_url_contains")
+            .and_then(serde_json::Value::as_str)
+            .filter(|hint| !hint.trim().is_empty())
+        else {
+            return ToolResult::error(
+                "target_url_contains must be a nonempty URL substring. No page was read.",
+            );
+        };
+        let Some(pid) = args
+            .get("pid")
+            .and_then(serde_json::Value::as_u64)
+            .and_then(|pid| u32::try_from(pid).ok())
+            .filter(|pid| *pid != 0)
+        else {
+            return ToolResult::error(
+                "A valid pid is required for a targeted page read. No page was read.",
+            );
+        };
+        let Some(hwnd) = args
+            .get("window_id")
+            .and_then(serde_json::Value::as_u64)
+            .filter(|hwnd| *hwnd != 0)
+        else {
+            return ToolResult::error(
+                "A valid window_id is required for a targeted page read. No page was read.",
+            );
+        };
+        if crate::win32::window_owner_pid(hwnd) != Some(pid) {
+            return ToolResult::error("The page window does not belong to the named pid. Refresh list_windows; no page was read.");
+        }
+        let hint = hint.to_owned();
+        let selector = args
+            .get("css_selector")
+            .and_then(serde_json::Value::as_str)
+            .unwrap_or("*")
+            .to_owned();
+        let attributes: Vec<String> = args
+            .get("attributes")
+            .and_then(serde_json::Value::as_array)
+            .map(|items| {
+                items
+                    .iter()
+                    .filter_map(serde_json::Value::as_str)
+                    .map(str::to_owned)
+                    .collect()
+            })
+            .unwrap_or_default();
+        let query = action == "query_dom";
+        let result = tokio::task::spawn_blocking(move || unsafe {
+            let (automation, document) =
+                super::launch_browser::matching_document(hwnd, &hint, false)?;
+            let before = super::launch_browser::document_url(&document);
+            let text = if query {
+                query_dom_document(&automation, &document, &selector, &attributes)?
+            } else {
+                text_pattern_dump(&document).unwrap_or_else(|_| walk_text_blocking(&document))
+            };
+            let (_, current) = super::launch_browser::matching_document(hwnd, &hint, false)?;
+            if crate::win32::window_owner_pid(hwnd) != Some(pid)
+                || super::launch_browser::document_url(&document) != before
+                || !automation.CompareElements(&document, &current)?.as_bool()
+            {
+                anyhow::bail!(
+                    "The matching tab changed during the read. Its text was discarded; retry."
+                );
+            }
+            Ok::<_, anyhow::Error>(text)
+        })
+        .await;
+        match result {
+            Ok(Ok(text)) => ToolResult::text(text),
+            Ok(Err(error)) => ToolResult::error(format!("Targeted page read refused: {error}")),
+            Err(error) => ToolResult::error(format!("Targeted page read failed: {error}")),
+        }
+    }
