@@ -105,35 +100,7 @@ pub(super) fn task_manager_direct_path(target: &str) -> Result<Option<String>, S
     {
         return Ok(None);
     }
-    let snapshot = unsafe { CreateToolhelp32Snapshot(TH32CS_SNAPPROCESS, 0) }.map_err(|e| {
