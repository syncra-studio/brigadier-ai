     use super::*;
+    #[test]
+    fn field_bounds_use_ltrb_and_exclude_other_renderers() {
+        assert!(contains_field_center(
+            (1000, 500, 1200, 700),
+            (1050, 550, 1150, 650)
+        ));
+        assert!(!contains_field_center(
+            (1000, 500, 1200, 700),
+            (1500, 500, 1800, 900)
+        ));
+        assert!(!contains_field_center(
+            (1200, 500, 1000, 700),
+            (0, 0, 2000, 1000)
+        ));
+        assert!(contains_field_center(
+            (i32::MIN, 0, i32::MAX, 100),
+            (i32::MIN, 0, i32::MAX, 100)
+        ));
+    }
