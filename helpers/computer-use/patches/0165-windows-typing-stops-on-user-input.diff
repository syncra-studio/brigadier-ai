+/// reach these hooks.
+static USER_INPUT_EVENTS: AtomicU64 = AtomicU64::new(0);
+
+pub(crate) fn user_input_events() -> u64 {
+    USER_INPUT_EVENTS.load(Ordering::Acquire)
