+    pub visible: bool,
+    pub root: bool,
+    pub iconic: bool,
+    pub topmost: bool,
+    pub tool: bool,
+    pub target: bool,
+}
+
+pub(crate) fn place_behind_prior(facts: CoverFacts) -> bool {
+    facts.visible && facts.root && !facts.iconic && !facts.topmost && !facts.tool && facts.target
+}
