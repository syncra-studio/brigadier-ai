         assert!(summary("Toggle", false, true).contains("confirmed a control"));
     }
 }
+
+/// Keyboard dispatch has no semantic readback. Neither S_OK nor a queued
+/// message proves that an accelerator ran or a key reached the target.
+pub fn dispatch_summary(action: &str, route: &str) -> String {
+    format!(
+        "Dispatched {action} via {route}; effect not confirmed. Read fresh state before retrying."
+    )
+}
+
+#[cfg(test)]
+mod key_tests {
+    #[test]
+    fn every_unobserved_key_route_reports_uncertainty() {
+        for route in ["PostMessage", "SendInput", "UIA accelerator"] {
+            let text = super::dispatch_summary("Ctrl+S", route);
+            assert!(text.contains("not confirmed"), "{text}");
+            assert!(
+                !text.contains("✅") && !text.contains("Pressed") && !text.contains("Performed")
+            );
+        }
+    }
+}
--- a/crates/platform-windows/src/tools/impl_.rs
+++ b/crates/platform-windows/src/tools/impl_.rs
@@ -5131,6 +5131,33 @@

 // ── press_key ─────────────────────────────────────────────────────────────────

+fn unconfirmed_key_result(action: &str, path: &str) -> ToolResult {
+    ToolResult::text(crate::input_outcome::dispatch_summary(action, path))
+        .with_structured(json!({"path": path, "verified": false, "effect": "unverifiable"}))
+}
+
+#[cfg(test)]
+mod key_outcome_tests {
+    #[test]
+    fn windows_key_result_never_promotes_dispatch_to_success() {
+        use cua_driver_core::protocol::Content;
+        for path in ["PostMessage", "SendInput", "uia"] {
+            let result = super::unconfirmed_key_result("Ctrl+S", path);
+            assert_eq!(
+                result.structured_content.as_ref().unwrap()["verified"],
+                false
+            );
+            assert_eq!(
+                result.structured_content.as_ref().unwrap()["effect"],
+                "unverifiable"
+            );
+            assert!(result.content.iter().any(
+                |c| matches!(c, Content::Text { text, .. } if text.contains("not confirmed"))
+            ));
+        }
+    }
+}
